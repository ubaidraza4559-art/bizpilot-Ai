# Copy to .env and fill in. No real secrets belong in this file.
PORT=3000
NODE_ENV=development
AUTH_SECRET=change-this-to-a-long-random-secret
DATABASE_PATH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Production target only (Supabase / Next.js) — not used by the local build:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Billing integration point only (not active until verified server-side):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

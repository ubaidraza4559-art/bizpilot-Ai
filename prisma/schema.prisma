// Prisma schema for the PostgreSQL production target (see README §4).
// The local build uses the equivalent SQLite schema in server.js.
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Profile { id String @id @db.Uuid; fullName String; email String @unique; businessName String @default(""); businessType String @default(""); preferredLanguage String @default("English"); plan String @default("FREE"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; leads Lead[]; followUps FollowUp[]; proposals Proposal[]; templates MessageTemplate[]; aiHistory AiGenerationHistory[]; aiUsage AiUsage[]; subscriptions Subscription[] }
model Lead { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; user Profile @relation(fields: [userId], references: [id], onDelete: Cascade); clientName String; email String @default(""); phone String @default(""); company String @default(""); service String @default(""); source String @default("Other"); budget Float @default(0); currency String @default("USD"); status String @default("New"); priority String @default("Medium"); notes String @default(""); nextFollowUp DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; followUps FollowUp[] }
model FollowUp { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; user Profile @relation(fields: [userId], references: [id], onDelete: Cascade); leadId String? @db.Uuid; lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull); title String; notes String @default(""); dueDate DateTime; status String @default("Pending"); completedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Proposal { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; user Profile @relation(fields: [userId], references: [id], onDelete: Cascade); leadId String? @db.Uuid; clientName String; clientCompany String @default(""); title String; overview String @default(""); scope String @default(""); deliverables Json @default("[]"); timeline String @default(""); currency String @default("USD"); taxRate Float @default(0); discount Float @default(0); paymentTerms String @default(""); notes String @default(""); status String @default("Draft"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model MessageTemplate { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; user Profile @relation(fields: [userId], references: [id], onDelete: Cascade); title String; category String @default("General"); body String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model AiGenerationHistory { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; user Profile @relation(fields: [userId], references: [id], onDelete: Cascade); outputType String; tone String @default("Professional"); language String @default("English"); inputText String @default(""); outputText String; provider String @default("template"); createdAt DateTime @default(now()) }
model AiUsage { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; user Profile @relation(fields: [userId], references: [id], onDelete: Cascade); month String; count Int @default(0); @@unique([userId, month]) }
model Subscription { id String @id @default(uuid()) @db.Uuid; userId String @db.Uuid; user Profile @relation(fields: [userId], references: [id], onDelete: Cascade); plan String; status String @default("active"); stripeSubscriptionId String?; currentPeriodEnd DateTime?; createdAt DateTime @default(now()) }
model Workspace { id String @id @default(uuid()) @db.Uuid; ownerId String @db.Uuid; name String; createdAt DateTime @default(now()); members WorkspaceMember[] }
model WorkspaceMember { id String @id @default(uuid()) @db.Uuid; workspaceId String @db.Uuid; workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade); userId String @db.Uuid; role String @default("member"); @@unique([workspaceId, userId]) }
